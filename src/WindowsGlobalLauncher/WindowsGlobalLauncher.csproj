<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- 版本号唯一来源：发布时由 CI 用 -p:Version=<tag去掉v前缀> 覆盖，运行期从程序集特性读取（见 App.AppVersion） -->
    <Version>1.0.7</Version>
    <RootNamespace>windows_global_launcher</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 增强 OCR 安装器：7z 解压（RapidOCR-json 增强包为 7z 格式） -->
    <PackageReference Include="SharpCompress" Version="0.50.4" />
  </ItemGroup>
</Project>
