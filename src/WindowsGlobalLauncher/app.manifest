<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WindowsGlobalLauncher.app" />

  <!--
    以管理员（高完整性级别）运行。
    低级键盘钩子无法拦截发往“比自己完整性级别更高”的进程的按键，
    Unreal 等常以管理员运行的游戏会因此绕过钩子、触发系统原生 Alt+Tab。
    提升到 requireAdministrator 后，钩子才能正常吞掉这些进程前台时的 Alt+Tab。
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- 声明支持的 Windows 版本，确保 DPI / 行为按现代系统处理 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
